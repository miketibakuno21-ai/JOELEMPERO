                        Return to Joel's Home Page
                    </button>
                </div>
            `;
        }

        let arcadeCanvas, arcadeCtx, gameAnimId;
        let player = { x: 40, y: 140, w: 20, h: 20, vy: 0, gravity: 0.7, jumping: false };
        let obstacles = [];
        let score = 0;

        function initArcadeGame() {
            arcadeCanvas = document.getElementById('arcade-canvas');
            if (!arcadeCanvas) return;
            arcadeCtx = arcadeCanvas.getContext('2d');

            window.onkeydown = function(e) {
                if (e.code === 'Space' && browserState.gameActive) {
                    e.preventDefault();
                    jumpPlayer();
                }
            };

            arcadeCanvas.onclick = function() {
                if (browserState.gameActive) {
                    jumpPlayer();
                }
            };

            drawStaticCanvas();
        }

        function drawStaticCanvas() {
            if (!arcadeCtx) return;
            arcadeCtx.fillStyle = '#030712';
            arcadeCtx.fillRect(0, 0, arcadeCanvas.width, arcadeCanvas.height);

            // Draw Ground Line
            arcadeCtx.strokeStyle = '#374151';
            arcadeCtx.lineWidth = 2;
            arcadeCtx.beginPath();
            arcadeCtx.moveTo(0, 180);
            arcadeCtx.lineTo(600, 180);
            arcadeCtx.stroke();
        }

        function jumpPlayer() {
            if (!player.jumping) {
                player.vy = -11;
                player.jumping = true;
            }
        }

        function startArcadeGame() {
            const overlay = document.getElementById('arcade-overlay');
            if (overlay) overlay.classList.add('hidden');

            browserState.gameActive = true;
            score = 0;
            player.y = 140;
            player.vy = 0;
            player.jumping = false;
            obstacles = [];

            if (gameAnimId) cancelAnimationFrame(gameAnimId);
            runArcadeLoop();
        }

        function runArcadeLoop() {
            if (!browserState.gameActive) return;

            // Physics Update
            player.vy += player.gravity;
            player.y += player.vy;

            if (player.y >= 140) {
                player.y = 140;
                player.vy = 0;
                player.jumping = false;
            }

            // Obstacle Spawning
            if (Math.random() < 0.02 && (obstacles.length === 0 || obstacles[obstacles.length - 1].x < 430)) {
                obstacles.push({
                    x: 600,
                    y: 144,
                    w: 16,
                    h: 22,
                    speed: 5.5 + Math.floor(score / 80)
                });
            }

            // Move Obstacles & Collision Check
            for (let i = 0; i < obstacles.length; i++) {
                obstacles[i].x -= obstacles[i].speed;
                let obs = obstacles[i];

                if (
                    player.x < obs.x + obs.w &&
                    player.x + player.w > obs.x &&
                    player.y < obs.y + obs.h &&
                    player.y + player.h > obs.y
                ) {
                    endArcadeGame();
                    return;
                }
            }

            obstacles = obstacles.filter(o => o.x > -20);
            score++;

            // Draw Canvas Frame
            arcadeCtx.fillStyle = '#030712';
            arcadeCtx.fillRect(0, 0, arcadeCanvas.width, arcadeCanvas.height);

            // Ground Line
            arcadeCtx.strokeStyle = '#3b82f6';
            arcadeCtx.lineWidth = 2;
            arcadeCtx.beginPath();
            arcadeCtx.moveTo(0, 180);
            arcadeCtx.lineTo(600, 180);
            arcadeCtx.stroke();

            // Draw Player Box
            arcadeCtx.fillStyle = '#10b981';
            arcadeCtx.fillRect(player.x, player.y, player.w, player.h);

            // Draw Hazards
            arcadeCtx.fillStyle = '#ef4444';
            obstacles.forEach(obs => {
                arcadeCtx.fillRect(obs.x, obs.y, obs.w, obs.h);
            });

            // Score HUD
            arcadeCtx.fillStyle = '#f8fafc';
            arcadeCtx.font = '12px "Fira Code", monospace';
            arcadeCtx.fillText(`DISTANCE: ${score}`, 15, 25);

            gameAnimId = requestAnimationFrame(runArcadeLoop);
        }

        function endArcadeGame() {
            browserState.gameActive = false;
            const overlay = document.getElementById('arcade-overlay');
            if (overlay) {
                overlay.classList.remove('hidden');
                overlay.innerHTML = `
                    <i class="fas fa-burst text-3xl text-red-500 mb-2"></i>
                    <h4 class="text-base font-bold text-white">Collision Detected!</h4>
                    <p class="text-xs text-gray-400 mb-4">Distance Survived: <strong class="text-emerald-400">${score}</strong></p>
                    <button onclick="startArcadeGame()" class="px-5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-lg transition">
                        Play Again
                    </button>
                `;
            }
        }
    </script>
